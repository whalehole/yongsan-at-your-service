<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<title>{{.Title}} — Release notes</title>
<style>
:root{color-scheme:light;--ink:#18243a;--muted:#687386;--line:#e0e6ec;--paper:#fff;--wash:#f3f6f8;--accent:#0d7668;font:15px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--wash)}
*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0}a{color:var(--accent);text-underline-offset:3px}a:hover{color:#084c43}button,select{font:inherit}button,select,a,summary{touch-action:manipulation}:focus-visible{outline:3px solid #56bcae;outline-offset:4px}button{cursor:pointer}code{font:12px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere}p,h1,h2,h3,h4{margin:0}h1,h2,h3,h4{line-height:1.25}main{max-width:1240px;margin:auto;padding:35px 36px 45px}.masthead{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px}.brand{display:flex;align-items:center;gap:12px;font-size:12px;font-weight:750;letter-spacing:1.8px}.brand-mark{display:grid;place-items:center;width:33px;height:33px;border-radius:9px;background:var(--ink);color:#fff;font-size:17px;letter-spacing:0}.masthead-note{color:var(--muted);font-size:12px}.hero{position:relative;padding:40px 42px 32px;background:var(--paper);border:1px solid var(--line);border-top:5px solid var(--accent);border-radius:14px;box-shadow:0 8px 30px #18243a05}.hero-top{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:17px}.eyebrow{font-size:11px;font-weight:750;letter-spacing:1.8px;text-transform:uppercase;color:var(--accent)}.badge{display:inline-flex;align-items:center;gap:6px;border:1px solid;border-radius:30px;padding:4px 10px;font-size:11px;font-weight:700;line-height:1.5;white-space:nowrap}.draft{background:#fff8e7;color:#8b5d0a;border-color:#efdcac}.complete{background:#eaf6f1;color:#156453;border-color:#bbdfd2}.neutral{background:#f0f3f6;color:#536174;border-color:#d9e0e7}.incomplete{background:#fff0ef;color:#a53632;border-color:#ecc6c3}h1{max-width:950px;font-size:42px;letter-spacing:-1.5px;overflow-wrap:anywhere}.summary{max-width:900px;font-size:17px;color:#455166;margin-top:20px;line-height:1.75}.prose{white-space:pre-wrap;overflow-wrap:anywhere}.empty{color:#7b8696;font-weight:400;font-style:italic}.release-meta{display:grid;grid-template-columns:1fr 1fr 1.3fr 1.3fr;gap:20px;margin:29px 0 0;padding-top:24px;border-top:1px solid var(--line)}dt{font-size:10px;text-transform:uppercase;letter-spacing:1px;font-weight:750;color:var(--muted);margin-bottom:6px}dd{margin:0;overflow-wrap:anywhere}.release-meta dd{font-size:14px;font-weight:600}.release-meta code{font-size:13px}.statistics{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin:20px 0 31px}.stat{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:19px 22px}.stat strong{display:block;font-size:30px;line-height:1.1;letter-spacing:-.6px;margin-bottom:5px}.stat span{font-size:12px;color:var(--muted)}.warning{border:1px solid #edccc7;border-left:4px solid #b64339;border-radius:8px;background:#fff4f1;padding:17px 20px;margin:0 0 27px;color:#84392f;line-height:1.65}.warning strong{display:block;font-size:15px;color:#92372f;margin-bottom:3px}.warning a{color:inherit}.section-title{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:18px}h2{font-size:24px;letter-spacing:-.5px}.section-note{font-size:12px;color:var(--muted);margin-top:5px}.grouping-controls{display:flex;align-items:center;gap:10px;font-size:12px}.grouping-controls label{font-weight:650;white-space:nowrap}select{min-width:175px;padding:9px 31px 9px 11px;border:1px solid #ccd5df;border-radius:7px;background:#fff;color:var(--ink);font-size:13px}.print-button{border:1px solid #ccd5df;border-radius:7px;background:#fff;color:#455166;padding:8px 12px;font-size:12px}.group{margin-bottom:23px;border:1px solid var(--line);border-radius:11px;background:var(--paper);overflow:hidden}.group-header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:19px 23px;background:#f9fbfc;border-bottom:1px solid var(--line)}.group-kicker{color:var(--muted);font-size:10px;letter-spacing:1.2px;text-transform:uppercase;font-weight:750;margin-bottom:5px}.group-value{font-size:18px;letter-spacing:-.25px;white-space:pre-wrap;overflow-wrap:anywhere}.group-count{flex-shrink:0;border:1px solid #dce3ea;border-radius:30px;padding:4px 9px;color:var(--muted);font-size:11px;background:#fff;margin-top:3px}.commit{padding:23px 25px;border-bottom:1px solid var(--line)}.commit:last-child{border-bottom:0}.commit-top{display:flex;align-items:flex-start;gap:15px;justify-content:space-between;margin-bottom:10px}.repository{font-size:11px;font-weight:700;color:#4b657b;overflow-wrap:anywhere}.commit-link{font-size:11px;white-space:nowrap;flex-shrink:0}.original-title{font-size:16px;color:var(--ink);font-weight:600;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere}.commit-remarks{font-size:13px;line-height:1.7;font-weight:400;color:var(--muted);margin-top:8px}.remarks-label{font-weight:500}.annotations{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin:16px 0 0}.annotation{font-size:11px;color:#576478;border:1px solid #e0e6ec;border-radius:5px;background:#fafbfc;padding:4px 7px}.annotation strong{font-weight:700;color:#34475c;margin-right:5px}.commit-details{margin-top:16px}.commit-details summary{display:list-item;width:fit-content;cursor:pointer;font-size:11px;color:#617185;font-weight:650}.commit-details[open] summary{margin-bottom:12px}.detail-grid{display:grid;grid-template-columns:105px minmax(0,1fr);gap:8px 12px;margin:0;font-size:12px}.detail-grid dt{font-size:10px;margin:0;line-height:1.8}.detail-grid dd{color:#536174}.commit-message{margin:15px 0 0;padding:15px 17px;background:#f5f7fa;border:1px solid #e6eaf0;border-radius:6px;white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.75 ui-monospace,SFMono-Regular,Consolas,monospace;color:#4e5c70}.empty-state{padding:38px 25px;text-align:center;background:#fff;border:1px dashed #cbd6df;border-radius:10px;color:#657286;margin-bottom:24px}.empty-state h3{font-size:18px;color:#405168;margin-bottom:7px}.notes-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:31px 0}.notes-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:24px}.notes-card h2{font-size:19px;letter-spacing:-.2px;margin-bottom:15px}.notes-card ul{padding-left:19px;margin:0}.notes-card li{margin:9px 0;padding-left:4px;white-space:pre-wrap;overflow-wrap:anywhere}.notes-card .empty{font-size:13px}.coverage{margin-top:34px}.coverage-box{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:#fff}.coverage table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:12px}.coverage th{text-align:left;background:#f9fbfc;border-bottom:1px solid var(--line);padding:12px 17px;font-size:10px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted)}.coverage td{padding:16px 17px;vertical-align:top;border-bottom:1px solid var(--line);overflow-wrap:anywhere}.coverage tbody tr:last-child td{border-bottom:0}.coverage th:nth-child(1){width:29%}.coverage th:nth-child(2){width:18%}.coverage th:nth-child(3){width:41%}.coverage th:nth-child(4){width:12%}.range-line{display:block;margin-bottom:5px;color:#647287}.range-line strong{font-size:10px;text-transform:uppercase;letter-spacing:.5px;display:inline-block;width:36px}.scan-error{margin-top:8px;font-size:12px;color:#a53632;white-space:pre-wrap;line-height:1.65}.scan-metadata{margin-top:15px;display:flex;flex-wrap:wrap;gap:8px 20px;font-size:11px;color:#788496}.footer{display:flex;justify-content:space-between;gap:20px;padding-top:20px;margin-top:30px;border-top:1px solid #dce3e9;font-size:11px;color:#7a8697}
@media(max-width:760px){main{padding:20px 15px 30px}.masthead{margin-bottom:17px}.masthead-note{display:none}.hero{padding:25px 23px 23px}h1{font-size:32px;letter-spacing:-.9px}.summary{font-size:15px;margin-top:16px}.release-meta{grid-template-columns:1fr 1fr;gap:19px;margin-top:22px;padding-top:20px}.statistics{gap:8px;margin:14px 0 25px}.stat{padding:14px 12px}.stat strong{font-size:24px}.stat span{font-size:10px}.section-title{display:block}.grouping-controls{margin-top:15px;flex-wrap:wrap}.group-header{padding:16px 18px}.group-value{font-size:16px}.commit{padding:19px}.original-title{font-size:15px}.notes-grid{grid-template-columns:1fr;gap:14px;margin:25px 0}.notes-card{padding:20px}.coverage table{min-width:700px}.footer{display:block}.footer span{display:block;margin-bottom:5px}}
@media print{@page{size:A4;margin:14mm}:root{font-size:11px;background:white}main{max-width:none;padding:0}.masthead{margin-bottom:16px}.hero{box-shadow:none;padding:23px 26px;border-radius:7px}h1{font-size:29px}.summary{font-size:12px;margin-top:14px}.release-meta{margin-top:20px;padding-top:16px;gap:15px}.release-meta dd{font-size:11px}.release-meta code{font-size:10px}.statistics{gap:10px;margin:14px 0 22px}.stat{padding:12px 15px}.stat strong{font-size:23px}.stat span{font-size:10px}.grouping-controls,.print-button{display:none!important}h2{font-size:20px}.group{border-radius:6px}.group-header{padding:13px 17px;break-after:avoid}.group-value{font-size:15px}.commit{padding:17px 19px;break-inside:avoid}.commit-remarks{font-size:10px}.original-title{font-size:11px}.annotations{margin-top:12px}.annotation{font-size:9px}.detail-grid{font-size:10px}.commit-message{font-size:9px;padding:12px 14px}.notes-grid{gap:15px}.notes-card{padding:18px;break-inside:avoid}.notes-card h2{font-size:16px}.coverage-box{overflow:visible}.coverage table{font-size:10px;min-width:0}.coverage th,.coverage td{padding:11px 12px}.coverage .badge{font-size:9px;padding:3px 7px}.coverage code{font-size:9px}.coverage tr{break-inside:avoid}.scan-error{font-size:10px}.warning{padding:13px 16px;font-size:11px}.warning strong{font-size:13px}.footer{font-size:9px}a{color:inherit;text-decoration:none}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
</head>
<body><main>
<div class="masthead"><div class="brand"><span class="brand-mark" aria-hidden="true">Y</span><span>YAS / RELEASE NOTES</span></div><span class="masthead-note">A record of what changed</span></div>
<header class="hero">
<div class="hero-top"><p class="eyebrow">Release notes</p>{{if .Release.Draft}}<span class="badge draft">Draft · review before sharing</span>{{end}}</div>
<h1>{{.Title}}</h1>
{{if .Release.Summary}}<p class="summary prose">{{.Release.Summary}}</p>{{else}}<p class="summary empty">A release summary has not been added yet.</p>{{end}}
<dl class="release-meta">
<div><dt>Version</dt><dd>{{.Release.Version}}</dd></div><div><dt>Date</dt><dd>{{if .Release.Date}}{{.Release.Date}}{{else}}Not recorded{{end}}</dd></div>
<div><dt>Baseline</dt><dd>{{if .Release.From}}<code>{{.Release.From}}</code>{{else}}Per repository{{end}}</dd></div><div><dt>Target</dt><dd>{{if .Release.To}}<code>{{.Release.To}}</code>{{else}}Not recorded{{end}}</dd></div>
</dl>
</header>
<section class="statistics" aria-label="Release overview">
<div class="stat"><strong>{{.Stats.Commits}}</strong><span>Commit entries</span></div><div class="stat"><strong>{{.Stats.Repositories}}</strong><span>Repositories</span></div><div class="stat"><strong>{{.Stats.ChangeRequests}}</strong><span>Change requests</span></div><div class="stat"><strong>{{.Stats.Incidents}}</strong><span>Incidents</span></div>
</section>
{{if .Stats.Failed}}<aside class="warning" role="note"><strong>Incomplete scan · {{.Stats.Failed}} repository scan{{if ne .Stats.Failed 1}}s{{end}} failed</strong>Some release ranges could not be read completely. These failures are not evidence of no changes. Review the <a href="#repository-coverage">repository coverage and errors</a> before sharing this release.</aside>{{end}}
<section aria-labelledby="commits-heading">
<div class="section-title"><div><h2 id="commits-heading">Release changes</h2><p class="section-note" aria-live="polite">Grouped by <strong id="grouping-label">{{.InitialLabel}}</strong></p></div>
<div class="grouping-controls" id="grouping-controls" hidden><label for="group-by">Group commits by</label><select id="group-by" aria-controls="grouped-commits">{{range .Views}}<option value="{{.By}}"{{if .Selected}} selected{{end}}>{{.Label}}</option>{{end}}</select><button class="print-button" type="button" id="print-notes">Print / save PDF</button></div></div>
<div id="grouped-commits">{{range $view := .Views}}<section id="view-{{.By}}" data-group-view="{{.By}}" aria-label="Commits grouped by {{.Label}}"{{if not .Selected}} hidden{{end}}>
{{range .Groups}}<section class="group"><header class="group-header"><div><p class="group-kicker">{{$view.Label}}{{if .Missing}} · Not provided{{end}}</p><h3 class="group-value">{{.Value}}</h3></div><span class="group-count">{{len .Commits}} commit{{if ne (len .Commits) 1}}s{{end}}</span></header>{{range .Commits}}{{template "commit" .}}{{end}}</section>
{{else}}<div class="empty-state"><h3>No commit entries recorded</h3><p>{{if eq $.Stats.Repositories 0}}No repository scans were recorded in this document.{{else}}{{if $.Stats.Failed}}Review the incomplete repositories below before concluding that this release has no new commits.{{else}}The release document contains no commit entries.{{end}}{{end}}</p></div>{{end}}
</section>{{end}}</div>
</section>
<div class="notes-grid">
<section class="notes-card" aria-labelledby="upgrade-heading"><h2 id="upgrade-heading">Upgrade notes</h2>{{if .UpgradeNotes}}<ul>{{range .UpgradeNotes}}<li>{{.}}</li>{{end}}</ul>{{else}}<p class="empty">No upgrade notes provided.</p>{{end}}</section>
<section class="notes-card" aria-labelledby="issues-heading"><h2 id="issues-heading">Known issues</h2>{{if .KnownIssues}}<ul>{{range .KnownIssues}}<li>{{.}}</li>{{end}}</ul>{{else}}<p class="empty">No known issues provided.</p>{{end}}</section>
</div>
<section class="coverage" id="repository-coverage" aria-labelledby="coverage-heading"><div class="section-title"><div><h2 id="coverage-heading">Repository coverage</h2><p class="section-note">{{.Stats.Changed}} with new commits · {{.Stats.Unchanged}} without new commits · {{.Stats.Failed}} incomplete</p></div></div>
<div class="coverage-box"><table><thead><tr><th scope="col">Repository</th><th scope="col">Scan result</th><th scope="col">Pinned release range</th><th scope="col">Commits</th></tr></thead><tbody>
{{range .Repositories}}<tr><td><strong>{{.Project}}</strong>{{if .Error}}<p class="scan-error">{{.Error}}</p>{{else}}{{if eq .Class "incomplete"}}<p class="scan-error">The scan did not complete; review this repository before sharing.</p>{{end}}{{end}}</td><td><span class="badge {{.Class}}">{{.Label}}</span></td><td><span class="range-line"><strong>From</strong> {{if .FromRef}}<code>{{.FromRef}}</code>{{else}}<span class="empty">Not recorded</span>{{end}}</span>{{if .FromCommit}}<code>{{.FromCommit}}</code>{{end}}<span class="range-line"><strong>To</strong> {{if .ToRef}}<code>{{.ToRef}}</code>{{else}}<span class="empty">Not recorded</span>{{end}}</span>{{if .ToCommit}}<code>{{.ToCommit}}</code>{{end}}</td><td>{{len .Commits}}</td></tr>
{{else}}<tr><td colspan="4">No repository scans were recorded in this document.</td></tr>{{end}}
</tbody></table></div>
{{if or .Scan.StartedAt .Scan.FinishedAt}}<div class="scan-metadata">{{if .Scan.StartedAt}}<span>Scan started: {{.Scan.StartedAt}}</span>{{end}}{{if .Scan.FinishedAt}}<span>Scan finished: {{.Scan.FinishedAt}}</span>{{end}}</div>{{end}}
</section>
<footer class="footer"><span>YAS · Release notes</span><span>Commit metadata is retained for traceability.</span></footer>
</main>
<script>
(function () {
  'use strict';
  const select = document.getElementById('group-by');
  const views = Array.from(document.querySelectorAll('[data-group-view]'));
  const label = document.getElementById('grouping-label');
  document.getElementById('grouping-controls').hidden = false;
  select.addEventListener('change', function () {
    views.forEach(function (view) { view.hidden = view.dataset.groupView !== select.value; });
    label.textContent = select.options[select.selectedIndex].textContent;
  });
  document.getElementById('print-notes').addEventListener('click', function () { window.print(); });
  const disclosureStates = new Map();
  window.addEventListener('beforeprint', function () {
    document.querySelectorAll('[data-group-view]:not([hidden]) details').forEach(function (details) {
      disclosureStates.set(details, details.open);
      details.open = true;
    });
  });
  window.addEventListener('afterprint', function () {
    disclosureStates.forEach(function (open, details) { details.open = open; });
    disclosureStates.clear();
  });
}());
</script>
</body>
</html>
{{define "commit"}}<article class="commit">
<div class="commit-top"><span class="repository">{{.Repository}}</span>{{with safeURL .Commit.URL}}<a class="commit-link" href="{{.}}" target="_blank" rel="noopener noreferrer">{{if $.Commit.SHA}}{{shortSHA $.Commit.SHA}}{{else}}Open commit{{end}} ↗</a>{{else}}{{if .Commit.SHA}}<code class="commit-link">{{shortSHA .Commit.SHA}}</code>{{end}}{{end}}</div>
<h4 class="original-title">{{if .Commit.Title}}{{.Commit.Title}}{{else}}<span class="empty">No commit title recorded</span>{{end}}</h4>
{{if .Commit.Remarks}}<p class="commit-remarks prose"><span class="remarks-label">Remarks:</span> {{.Commit.Remarks}}</p>{{end}}
<div class="annotations"><span class="annotation"><strong>Change request</strong>{{eventID .Commit.ChangeRequest}}</span><span class="annotation"><strong>Incident</strong>{{eventID .Commit.Incident}}</span><span class="annotation"><strong>Author</strong>{{if .Commit.Author}}{{.Commit.Author}}{{else}}Not recorded{{end}}</span></div>
<details class="commit-details"><summary>Commit details</summary><dl class="detail-grid"><dt>Repository</dt><dd>{{.Repository}}</dd><dt>Full commit</dt><dd>{{if .Commit.SHA}}<code>{{.Commit.SHA}}</code>{{else}}Not recorded{{end}}</dd><dt>Committed</dt><dd>{{if .Commit.CommittedAt}}{{.Commit.CommittedAt}}{{else}}Not recorded{{end}}</dd></dl>{{if .Commit.Message}}<pre class="commit-message">{{.Commit.Message}}</pre>{{end}}</details>
</article>{{end}}
